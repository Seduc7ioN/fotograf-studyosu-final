rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isAdmin() { return isAuthenticated() && request.auth.token.role == 'admin'; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isBookingRequestStatus(status) {
      return status in ['new', 'contacted', 'proposal_sent', 'accepted', 'rejected'];
    }
    function isValidBookingRequestCreate() {
      return request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'email',
          'eventType',
          'preferredDate',
          'city',
          'venue',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 7 &&
        request.resource.data.phone.size() <= 40 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 120 &&
        request.resource.data.eventType is string &&
        request.resource.data.eventType.size() >= 2 &&
        request.resource.data.eventType.size() <= 60 &&
        request.resource.data.preferredDate is string &&
        request.resource.data.preferredDate.size() <= 20 &&
        request.resource.data.city is string &&
        request.resource.data.city.size() <= 80 &&
        request.resource.data.venue is string &&
        request.resource.data.venue.size() <= 140 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 800 &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }
    function isAlbumOwner(albumId) {
      let album = get(/databases/$(database)/documents/albums/$(albumId));
      return isAuthenticated() && album.data.customerId == request.auth.uid;
    }
    function photoExists(albumId, photoId) {
      return exists(/databases/$(database)/documents/albums/$(albumId)/photos/$(photoId));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isOwner(userId) && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }

    match /albums/{albumId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin();

      match /photos/{photoId} {
        allow read: if isAdmin() || isAlbumOwner(albumId);
        allow write: if isAdmin();
        allow update: if isAlbumOwner(albumId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectionStatus']);
      }
    }

    match /favorites/{favoriteId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        isAlbumOwner(request.resource.data.albumId) &&
        photoExists(request.resource.data.albumId, request.resource.data.photoId);
      allow update: if false;
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        isAlbumOwner(request.resource.data.albumId) &&
        photoExists(request.resource.data.albumId, request.resource.data.photoId) &&
        request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
    }

    // YENİ: Müşteri pending yüklemeleri
    match /pending_uploads/{uploadId} {
      // Müşteri kendi yüklemelerini görebilir; admin hepsini görebilir
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      // Yükleme kaydı Cloud Functions tarafından oluşturulur; müşteri yazamaz
      allow create, update, delete: if false;
    }

    match /analytics/{albumId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /income_records/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /schedule_events/{eventId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admin_push_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 20 &&
        request.resource.data.enabled is bool;
      allow delete: if isAdmin() && resource.data.uid == request.auth.uid;
    }

    match /booking_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isValidBookingRequestCreate();
      allow update: if isAdmin() &&
        isBookingRequestStatus(request.resource.data.status);
      allow delete: if isAdmin();
    }

    match /share_links/{token} {
      allow read: if true;
      allow write: if false;
    }

    match /site_showcase/{itemId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /site_music/{trackId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
