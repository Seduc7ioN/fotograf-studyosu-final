rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isAdmin() { return isAuthenticated() && request.auth.token.role == 'admin'; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isAlbumOwner(albumId) {
      let album = get(/databases/$(database)/documents/albums/$(albumId));
      return isAuthenticated() && album.data.customerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isOwner(userId) && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }

    match /albums/{albumId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin();

      match /photos/{photoId} {
        allow read: if isAdmin() || isAlbumOwner(albumId);
        allow write: if isAdmin();
        allow update: if isAlbumOwner(albumId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectionStatus']);
      }
    }

    match /favorites/{favoriteId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
    }

    // YENİ: Müşteri pending yüklemeleri
    match /pending_uploads/{uploadId} {
      // Müşteri kendi yüklemelerini görebilir; admin hepsini görebilir
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      // Yükleme kaydı Cloud Functions tarafından oluşturulur; müşteri yazamaz
      allow create, update, delete: if false;
    }

    match /analytics/{albumId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /income_records/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /schedule_events/{eventId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /share_links/{token} {
      allow read: if true;
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
